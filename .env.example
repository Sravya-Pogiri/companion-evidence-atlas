SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only. Lovable AI gateway key for the message pipeline. Never prefix with VITE_.
LOVABLE_API_KEY=
# Channel for the case line: "simulated" (default, in the page) or "photon" (iMessage via Photon 2.0 Beta).
# Photon needs all three keys below. If any is missing the app falls back to simulated.
CASELENS_CHANNEL=simulated
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_WEBHOOK_SECRET=
# Who may text the case line: phone numbers (any format) and/or iMessage emails, comma separated.
# Anyone else gets one "case team members only" reply. Empty lets nobody in.
TEAM_NUMBERS=
# Optional: how long (ms) to wait for more messages before answering. Default 5000.
PHOTON_BATCH_MS=5000
# Reads photos, voice notes and PDFs sent to the line, and answers questions. Server only.
# Voice notes and PDFs need Gemini; photos also work with LOVABLE_API_KEY.
GEMINI_API_KEY=
# Optional: override the Photon API host (default https://api.photon.codes).
PHOTON_API_URL=

# Deep Agents investigator service (services/investigator). The app calls it server-side for
# "Test this claim"; both read this file. Use any long random string as the token.
INVESTIGATOR_URL=http://localhost:8787
INVESTIGATOR_TOKEN=

# Optional: calendar feed link(s) to read case deadlines from (Google Calendar's secret iCal address,
# or a court's public .ics/webcal link). Comma-separated. Treat as secret; never commit.
CASE_CALENDAR_ICS_URLS=
